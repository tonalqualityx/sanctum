# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_PATH=./database/sanctum.db

# Directories
SITES_DIRECTORY=/home/mike/sanctum/sites
SSL_DIRECTORY=/home/mike/sanctum/ssl
LIBRARY_DIRECTORY=/home/mike/sanctum/library

# Docker
DOCKER_SOCKET=/var/run/docker.sock

# Security
JWT_SECRET=your-secret-key-here

# Logging
LOG_LEVEL=info

# Let's Encrypt (optional)
LETSENCRYPT_EMAIL=your-email@example.com