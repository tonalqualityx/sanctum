version: '3.8'

services:
  wordpress:
    build:
      context: .
      dockerfile: Dockerfile.wordpress
      args:
        PHP_VERSION: "{{PHP_VERSION}}"
    container_name: "{{SITE_NAME}}_wordpress"
    restart: unless-stopped
    ports:
      - "{{WP_PORT}}:80"
    environment:
      WORDPRESS_DB_HOST: mysql
      WORDPRESS_DB_USER: wordpress
      WORDPRESS_DB_PASSWORD: wordpress
      WORDPRESS_DB_NAME: wordpress
      WORDPRESS_DEBUG: 1
      WORDPRESS_DEBUG_LOG: 1
      WORDPRESS_CONFIG_EXTRA: |
        define('WP_REDIS_HOST', 'redis');
        define('WP_REDIS_PORT', 6379);
    volumes:
      - ./wordpress:/var/www/html
      - ./config/php.ini:/usr/local/etc/php/conf.d/custom.ini
      - ./config/wordpress.conf:/etc/apache2/sites-available/000-default.conf
    depends_on:
      - mysql
      - redis
    networks:
      - sanctum_network
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

  mysql:
    image: mysql:8.0
    container_name: "{{SITE_NAME}}_mysql"
    restart: unless-stopped
    environment:
      MYSQL_DATABASE: wordpress
      MYSQL_USER: wordpress
      MYSQL_PASSWORD: wordpress
      MYSQL_ROOT_PASSWORD: rootpassword
    volumes:
      - ./database:/var/lib/mysql
      - ./config/mysql.cnf:/etc/mysql/conf.d/custom.cnf
    ports:
      - "{{DB_PORT}}:3306"
    networks:
      - sanctum_network
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 30s
      timeout: 10s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: "{{SITE_NAME}}_redis"
    restart: unless-stopped
    command: redis-server --appendonly yes
    volumes:
      - ./redis:/data
    ports:
      - "{{REDIS_PORT}}:6379"
    networks:
      - sanctum_network
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3

  mailhog:
    image: mailhog/mailhog:latest
    container_name: "{{SITE_NAME}}_mailhog"
    restart: unless-stopped
    ports:
      - "{{MAILHOG_PORT}}:8025"
      - "{{SMTP_PORT}}:1025"
    networks:
      - sanctum_network
    healthcheck:
      test: ["CMD-SHELL", "wget --quiet --tries=1 --spider http://localhost:8025/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

  phpmyadmin:
    image: phpmyadmin:latest
    container_name: "{{SITE_NAME}}_phpmyadmin"
    restart: unless-stopped
    environment:
      PMA_HOST: mysql
      PMA_USER: root
      PMA_PASSWORD: rootpassword
      UPLOAD_LIMIT: 300M
    ports:
      - "{{PMA_PORT}}:80"
    depends_on:
      - mysql
    networks:
      - sanctum_network
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:80/ || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3

networks:
  sanctum_network:
    external: true